
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");
const scoreText = document.getElementById("score");
const startButton = document.getElementById("start");

let player, obstacles, coins, score, lives, running, animation;
let keys = {};
let highScore = Number(localStorage.getItem("neonHighScore")) || 0;

function resetGame() {
  player = { x: 165, y: 520, width: 30, height: 35, speed: 6 };
  obstacles = [];
  coins = [];
  score = 0;
  lives = 3;
  running = true;
  scoreText.textContent = "0";
  startButton.textContent = "RESTART";
  cancelAnimationFrame(animation);
  loop();
}

function drawPlayer() {
  ctx.shadowBlur = 20;
  ctx.shadowColor = "#00f7ff";
  ctx.fillStyle = "#00f7ff";
  ctx.beginPath();
  ctx.moveTo(player.x + 15, player.y);
  ctx.lineTo(player.x + 30, player.y + 35);
  ctx.lineTo(player.x + 15, player.y + 27);
  ctx.lineTo(player.x, player.y + 35);
  ctx.closePath();
  ctx.fill();
  ctx.shadowBlur = 0;
}

function spawnObjects() {
  if (Math.random() < 0.025) {
    obstacles.push({
      x: Math.random() * 320,
      y: -30,
      size: 25 + Math.random() * 15,
      speed: 3 + score / 400
    });
  }

  if (Math.random() < 0.012) {
    coins.push({
      x: 15 + Math.random() * 330,
      y: -20,
      size: 10,
      speed: 3
    });
  }
}

function collision(a, b) {
  return a.x < b.x + b.size &&
    a.x + a.width > b.x &&
    a.y < b.y + b.size &&
    a.y + a.height > b.y;
}

function loop() {
  if (!running) return;

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Background stars
  for (let i = 0; i < 35; i++) {
    ctx.fillStyle = "#555577";
    ctx.fillRect((i * 71) % 360, (i * 113 + score * 2) % 600, 2, 2);
  }

  // Player movement
  if (keys.ArrowLeft || keys.a) player.x -= player.speed;
  if (keys.ArrowRight || keys.d) player.x += player.speed;
  player.x = Math.max(0, Math.min(330, player.x));

  drawPlayer();
  spawnObjects();

  obstacles.forEach((o, i) => {
    o.y += o.speed;
    ctx.shadowBlur = 15;
    ctx.shadowColor = "#ff35c8";
    ctx.fillStyle = "#ff35c8";
    ctx.fillRect(o.x, o.y, o.size, o.size);
    ctx.shadowBlur = 0;

    if (collision(player, o)) {
      obstacles.splice(i, 1);
      lives--;
      if (lives <= 0) endGame();
    }
  });

  coins.forEach((c, i) => {
    c.y += c.speed;
    ctx.shadowBlur = 15;
    ctx.shadowColor = "#00f7ff";
    ctx.fillStyle = "#00f7ff";
    ctx.beginPath();
    ctx.arc(c.x, c.y, c.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;

    if (Math.hypot(player.x + 15 - c.x, player.y + 15 - c.y) < 25) {
      score += 25;
      coins.splice(i, 1);
    }
  });

  score++;
  scoreText.textContent = score + " | ❤️ " + lives;
  animation = requestAnimationFrame(loop);
}

function endGame() {
  running = false;
  cancelAnimationFrame(animation);

  if (score > highScore) {
    highScore = score;
    localStorage.setItem("neonHighScore", highScore);
  }

  ctx.fillStyle = "white";
  ctx.textAlign = "center";
  ctx.font = "bold 28px Arial";
  ctx.fillText("GAME OVER", 180, 270);
  ctx.font = "16px Arial";
  ctx.fillText("Score: " + score, 180, 310);
  ctx.fillText("Best: " + highScore, 180, 340);
}

document.addEventListener("keydown", e => {
  keys[e.key] = true;
});

document.addEventListener("keyup", e => {
  keys[e.key] = false;
});

canvas.addEventListener("pointermove", e => {
  if (!running) return;
  const rect = canvas.getBoundingClientRect();
  const scale = canvas.width / rect.width;
  player.x = Math.max(0, Math.min(330,
    (e.clientX - rect.left) * scale - 15
  ));
});

startButton.addEventListener("click", resetGame);
